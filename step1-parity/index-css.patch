--- a/src/index.css
+++ b/src/index.css
@@ -22,3 +22,39 @@
 
 button:focus-visible { outline: 2px solid #edcf82; outline-offset: 4px; }
 ::selection { background: #d5b36b; color: #10222a; }
+
+:root {
+  --duck-safe-top: env(safe-area-inset-top, 0px);
+  --duck-safe-right: env(safe-area-inset-right, 0px);
+  --duck-safe-bottom: env(safe-area-inset-bottom, 0px);
+  --duck-safe-left: env(safe-area-inset-left, 0px);
+  color-scheme: dark;
+}
+
+html, body, #root { min-width:0; min-height:0; overscroll-behavior:none; }
+body { -webkit-text-size-adjust:100%; touch-action:none; }
+canvas { image-rendering: pixelated; image-rendering: crisp-edges; }
+.duck-responsive-shell {
+  position:fixed!important; inset:0; width:100vw!important; height:100vh!important; height:100dvh!important; min-height:100svh;
+  box-sizing:border-box; padding:var(--duck-safe-top) var(--duck-safe-right) var(--duck-safe-bottom) var(--duck-safe-left); overflow:hidden;
+  background:radial-gradient(ellipse at 50% 46%,#111a2a,#070b16 47%,#020309)!important;
+}
+.duck-responsive-shell::before {content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(90deg,rgba(76,91,112,.045) 0 1px,transparent 1px 96px),linear-gradient(90deg,rgba(0,0,0,.48),transparent 24%,transparent 76%,rgba(0,0,0,.48));opacity:.9;}
+.duck-responsive-shell::after {content:"";position:absolute;inset:18px;pointer-events:none;border:1px solid rgba(96,117,139,.08);box-shadow:inset 0 0 80px #00000059;}
+.duck-responsive-stage {flex:0 0 auto;max-width:calc(100vw - var(--duck-safe-left) - var(--duck-safe-right));max-height:calc(100dvh - var(--duck-safe-top) - var(--duck-safe-bottom));transform:translateZ(0);box-shadow:0 22px 80px #00000094,0 0 0 1px #7a91a021,0 0 32px #14223438;}
+.duck-responsive-stage canvas {touch-action:none;user-select:none;}
+.duck-responsive-footer {position:fixed!important;left:50%;bottom:max(6px,var(--duck-safe-bottom));transform:translateX(-50%);margin-top:0!important;max-width:calc(100vw - var(--duck-safe-left) - var(--duck-safe-right) - 16px);pointer-events:none;white-space:nowrap;text-shadow:0 1px 2px #000;opacity:.76;}
+.duck-responsive-footer>* {pointer-events:auto;}
+.duck-responsive-fullscreen {background:#04050b94;backdrop-filter:blur(4px);}
+:fullscreen .duck-responsive-footer {display:none!important;}
+@media (max-width:760px),(max-height:500px) {
+  .duck-frame-far {display:none;}
+  .duck-frame-near {inset:-4px!important;}
+  .duck-responsive-hint {display:none!important;}
+  .duck-responsive-footer {font-size:9px!important;bottom:max(4px,var(--duck-safe-bottom));}
+}
+@media (max-width:520px) {
+  .duck-responsive-fullscreen {padding:1px 5px!important;letter-spacing:.05em;}
+  .duck-responsive-shell::before {opacity:.25;}
+}
+@media (prefers-reduced-motion:reduce) {.duck-responsive-stage {transition:none!important;}}
