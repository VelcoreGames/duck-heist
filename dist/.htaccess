# Caché para velcoregames.com
# - Páginas HTML: siempre preguntan si hay versión nueva (pesan pocos KB).
# - Archivos del juego con huella en el nombre (/assets/*-AbC123.js): no cambian nunca, se guardan un año.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
Options -Indexes
